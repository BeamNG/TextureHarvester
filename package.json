{
  "name": "texture-harvester",
  "version": "0.6.0",
  "private": true,
  "description": "Mark quads on a photo, flatten them into textures, pack an atlas. One self-contained HTML file.",
  "author": "Thomas Fischer",
  "license": "MIT",
  "homepage": "https://beamng.github.io/TextureHarvester/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeamNG/TextureHarvester.git"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "i18n": "node scripts/compile-i18n.mjs",
    "predev": "node scripts/compile-i18n.mjs",
    "dev": "vite",
    "prebuild": "node scripts/compile-i18n.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "node scripts/compile-i18n.mjs",
    "test": "node build.mjs --with-tests && node run-tests.mjs"
  },
  "devDependencies": {
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "three": "^0.185.1",
    "vue": "^3.5.40",
    "vuetify": "^4.1.7"
  }
}
